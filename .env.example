# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Nama tabel: bisa nama tabel biasa (contoh: users) atau dengan skema (contoh: memfinance.user_profiles)
SUPABASE_TABLE=users
# Opsional: Jika menggunakan custom schema (default: public)
# SUPABASE_SCHEMA=memfinance

# Opsional: Interval durasi ticker (default: 72h / 3 hari)
# Contoh nilai valid: 72h, 48h, 24h, 1h, 30m, 10s (untuk pengujian)
KEEP_ALIVE_INTERVAL=72h

# Opsional: HTTP Request Timeout (default: 30s)
HTTP_TIMEOUT=30s
